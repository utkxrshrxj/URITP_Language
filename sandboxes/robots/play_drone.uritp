# Copied from the URITP playground's robots (github.com/senthuran2107/URITP, MIT licence).
manifest "Playground field drone (simulated)":
    uritp 0.1
    frame base: pose3d max_speed 3m/s
    actuator sprayer: states [off, on]
    sensor camera: camera
    sensor height: range dimension Length
    profiles [core, flight, vision, tooling, speech]
    safety max_speed 3m/s
    safety forbidden_zone zones.beehives
