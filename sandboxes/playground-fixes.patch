diff --git a/uritp/units.py b/uritp/units.py
index 760f607..b609c5c 100644
--- a/uritp/units.py
+++ b/uritp/units.py
@@ -64,6 +64,8 @@ class Percent:
     def _chk(self, o):
         if not isinstance(o, Percent):
             raise TypeError("cannot compare Percent with a non-percentage")
+    def __add__(self, o): self._chk(o); return Percent(self.value + o.value)
+    def __sub__(self, o): self._chk(o); return Percent(self.value - o.value)
     def __lt__(self, o): self._chk(o); return self.value < o.value
     def __le__(self, o): self._chk(o); return self.value <= o.value
     def __gt__(self, o): self._chk(o); return self.value > o.value
