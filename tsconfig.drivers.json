{
  // Type-checks the drivers together with the compiler core. Drivers must stay free of
  // Node-only code too, so a browser demo can drive the simulated robots later.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "drivers"],
  "exclude": ["**/*.test.ts"]
}
