{
  "name": "uritp",
  "version": "0.1.1",
  "description": "URITP: a small, safe language and compiler that turns human requests into checked robot instructions",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "uritp": "dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.drivers.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "uritp": "node dist/src/cli/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utkxrshrxj/URITP_Language.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  }
}
