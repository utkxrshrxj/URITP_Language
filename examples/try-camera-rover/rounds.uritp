# A rover with a camera does its rounds, keeps away from the stairs, and takes a photo at each
# stop: a "blocked" photo if something is close in front. Ready to run on a simulated rover.

robot rover = connect("lab:rover-1")

for point in route.rounds:
    move rover.base to point speed 0.2m/s
        avoid zones.stairs
    if rover.sense("distance_front").value < 30cm:
        capture rover.camera save as "blocked_{point.name}.jpg"
    else:
        capture rover.camera save as "{point.name}.jpg"
move rover.base to places.dock
